# Cloudflare Pages custom response headers.
# Purpose: make HTML pages ALWAYS revalidate so a crew member's browser can never
# pin a stale copy of a page (e.g. an old field-sample.html that still showed the
# "SAMPLE PREVIEW" badge / "Phase 2" footer and polled on the old slow cadence).
# Static, content-hashed assets may still cache normally.

# All HTML pages: never trust a cached copy without checking the origin first.
/*.html
  Cache-Control: no-cache, must-revalidate

# The field tool specifically (belt-and-suspenders; also covers the clean URL asset).
/field-sample.html
  Cache-Control: no-cache, must-revalidate
