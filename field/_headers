# Cloudflare Pages _headers
# Targeted header overrides for password-reset pages.
# These pages handle or display a one-time token; Referrer-Policy: no-referrer
# prevents that token from leaking in the HTTP Referer header if the user
# clicks an external link or the browser follows a redirect. CSP locks them
# down to same-origin resources only (no CDN fonts, no external scripts).

/forgot-password.html
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'

/reset.html
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'
